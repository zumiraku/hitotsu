# docker compose 用。.env にコピーして値を入れる
DB_PASSWORD=change-me-to-a-long-random-string
APP_PORT=3000
STORAGE_DRIVER=local
MAX_UPLOAD_MB=50
# S3 互換ストレージを使う場合
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=ap-northeast-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# AI アシスト（任意）
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
