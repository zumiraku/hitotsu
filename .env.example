# ローカル開発用。本番では必ず別の値にすること
DATABASE_URL="postgresql://postgres:hitotsu_dev@localhost:5432/hitotsu?schema=public"

# ファイルの保存先。local（既定）か s3
STORAGE_DRIVER=local
# local のときの保存フォルダ（省略時はプロジェクト直下の storage/）
# STORAGE_DIR=./storage
# s3 のとき
# S3_BUCKET=
# S3_REGION=ap-northeast-1
# S3_ENDPOINT=            # MinIO や R2 など S3 互換サービスを使う場合
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# 1ファイルの上限（MB）
MAX_UPLOAD_MB=50
